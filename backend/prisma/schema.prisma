generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  AGENT
}

enum InterventionType {
  REGULAR
  PUNCTUAL
}

enum InterventionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
  CANCELLED
  NO_SHOW
}

enum AttendanceStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AbsenceType {
  SICK
  PAID_LEAVE
  UNPAID
  OTHER
}

enum AnomalyStatus {
  NEW
  RESOLVED
}

enum NotificationAudience {
  ALL_AGENTS
  SITE_AGENTS
  AGENT
}

enum AuditAction {
  CREATE_NOTIFICATION
  CREATE_ABSENCE
  UPDATE_ABSENCE_STATUS
  CREATE_MANUAL_ATTENDANCE
  UPDATE_ATTENDANCE
  CANCEL_ATTENDANCE
  UPDATE_SETTINGS
  CREATE_USER
  UPDATE_USER
  UPDATE_USER_STATUS
  RESET_USER_PASSWORD
  CREATE_SITE
  UPDATE_SITE
  DELETE_SITE
  CREATE_INTERVENTION
  UPDATE_INTERVENTION
  UPDATE_INTERVENTION_STATUS
  CANCEL_INTERVENTION
  DUPLICATE_INTERVENTION
  CREATE_TEMPLATE_STOP
  UPDATE_TEMPLATE_STOP_AGENTS
  DELETE_TEMPLATE_STOP
  CREATE_TEMPLATE_EXCEPTION
  DELETE_TEMPLATE_EXCEPTION
  RESTORE_TEMPLATE_REVISION
  PROPOSE_TEMPLATE_CHANGE
  CREATE_APPROVAL_REQUEST
  APPROVE_REQUEST
  REJECT_REQUEST
  SEND_CLIENT_PLANNING
  CREATE_QUOTE
  UPDATE_QUOTE
  SEND_QUOTE
  DELETE_QUOTE
  CONVERT_QUOTE_TO_INVOICE
  CREATE_INVOICE
  UPDATE_INVOICE
  SEND_INVOICE
  RECORD_INVOICE_PAYMENT
  DELETE_INVOICE
}

enum ShiftSwapStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum EmployeeDocumentType {
  CONTRACT
  BADGE
  LICENSE
  OTHER
}

enum AvailabilityType {
  AVAILABLE
  UNAVAILABLE
}

enum ApprovalActionType {
  CREATE_INTERVENTION
  UPDATE_INTERVENTION_SCHEDULE
  ASSIGN_AGENT
  UNASSIGN_AGENT
  CANCEL_INTERVENTION
  CREATE_TEMPLATE_BATCH
  VALIDATE_TEMPLATE
  CANCEL_OCCURRENCE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

model User {
  id                          String                   @id @default(cuid())
  firstName                   String
  lastName                    String
  email                       String                   @unique
  phone                       String?
  address                     String?
  latitude                    Float?
  longitude                   Float?
  role                        Role
  password                    String
  active                      Boolean                  @default(true)
  twoFactorSecret             String?
  twoFactorEnabled            Boolean                  @default(false)
  passwordResetTokenHash      String?
  passwordResetTokenExpiresAt DateTime?
  permissions                 String[]                 @default([])
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  supervising                 SiteSupervisor[]
  interventions               InterventionAssignment[]
  attendance                  Attendance[]
  absences                    Absence[]
  pushTokens                  PushToken[]
  anomalies                   Anomaly[]
  loginEvents                 LoginEvent[]
  certifications              Certification[]
  employeeDocuments           EmployeeDocument[]
  shiftSwapRequestsMade       ShiftSwapRequest[]       @relation("ShiftSwapRequester")
  shiftSwapRequestsIn         ShiftSwapRequest[]       @relation("ShiftSwapTarget")
  teamPosts                   TeamPost[]
  badges                      UserBadge[]
  onboardingItems             UserOnboardingItem[]
  availabilities              Availability[]
  validatedTemplates          InterventionTemplate[]   @relation("TemplateValidator")
  leaveAllocations            LeaveAllocation[]
  chatThread                  ChatMessage[]            @relation("ChatThread")
  chatMessagesSent            ChatMessage[]            @relation("ChatSender")
  dashboardLayout             UserDashboardLayout?
  approvalRequestsMade        ApprovalRequest[]        @relation("ApprovalRequester")
  approvalRequestsReviewed    ApprovalRequest[]        @relation("ApprovalReviewer")
}

model ApprovalRequest {
  id            String             @id @default(cuid())
  actionType    ApprovalActionType
  entityType    String
  entityId      String?
  payload       Json
  previousState Json?
  status        ApprovalStatus     @default(PENDING)
  requestedById String?
  requestedBy   User?              @relation("ApprovalRequester", fields: [requestedById], references: [id])
  reviewedById  String?
  reviewedBy    User?              @relation("ApprovalReviewer", fields: [reviewedById], references: [id])
  reviewComment String?
  createdAt     DateTime           @default(now())
  reviewedAt    DateTime?

  @@index([status])
  @@index([entityType, entityId])
}

model Certification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  obtainedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model EmployeeDocument {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmployeeDocumentType
  label     String
  fileUrl   String
  createdAt DateTime             @default(now())
}

model ShiftSwapRequest {
  id             String          @id @default(cuid())
  interventionId String
  intervention   Intervention    @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  requesterId    String
  requester      User            @relation("ShiftSwapRequester", fields: [requesterId], references: [id])
  targetUserId   String?
  target         User?           @relation("ShiftSwapTarget", fields: [targetUserId], references: [id])
  status         ShiftSwapStatus @default(PENDING)
  reason         String?
  createdAt      DateTime        @default(now())
  respondedAt    DateTime?
}

model TeamPost {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  message   String
  photos    String[] @default([])
  createdAt DateTime @default(now())
}

model Badge {
  id          String      @id @default(cuid())
  code        String      @unique
  label       String
  description String?
  icon        String?
  createdAt   DateTime    @default(now())
  awards      UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  period    String?
  note      String?
  awardedBy String?
  awardedAt DateTime @default(now())
}

model OnboardingTemplateItem {
  id    String @id @default(cuid())
  label String
  order Int    @default(0)
}

model UserOnboardingItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  order       Int       @default(0)
  done        Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Availability {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  type      AvailabilityType
  note      String?
  createdAt DateTime         @default(now())

  @@unique([userId, date])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model Webhook {
  id        String   @id @default(cuid())
  url       String
  events    String[]
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Site {
  id                     String                @id @default(cuid())
  name                   String
  address                String
  latitude               Float?
  longitude              Float?
  timeWindow             String?
  active                 Boolean               @default(true)
  accessInstructions     String?
  accessCode             String?
  contactName            String?
  contactPhone           String?
  contactEmail           String?
  photos                 String[]              @default([])
  gpsDistanceMeters      Int?
  toleranceMinutes       Int?
  minimumDurationMinutes Int?
  planImageUrl           String?
  qrSecret               String?
  supervisors            SiteSupervisor[]
  interventions          Intervention[]
  absences               Absence[]
  interventionTemplate   InterventionTemplate?
  categories             SiteCategory[]
  contracts              SiteContract[]
  zones                  SiteZone[]
  inventoryItems         InventoryItem[]
  quotes                 Quote[]
  invoices               Invoice[]
  clientPortalTokens     ClientPortalToken[]
}

model SiteContract {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  label       String
  startDate   DateTime
  endDate     DateTime
  slaDetails  String?
  documentUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryItem {
  id           String   @id @default(cuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name         String
  barcode      String?
  unit         String   @default("unité")
  quantity     Int      @default(0)
  minThreshold Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteZone {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  label     String
  floor     String?
  order     Int      @default(0)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InterventionCategory {
  id             String         @id @default(cuid())
  label          String
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  siteCategories SiteCategory[]
  templateStops  TemplateStop[]
  interventions  Intervention[]
}

model SiteCategory {
  id         String                      @id @default(cuid())
  siteId     String
  site       Site                        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  categoryId String
  category   InterventionCategory        @relation(fields: [categoryId], references: [id])
  startTime  String
  endTime    String
  active     Boolean                     @default(true)
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  checklist  SiteCategoryChecklistItem[]

  @@unique([siteId, categoryId])
}

model SiteCategoryChecklistItem {
  id             String       @id @default(cuid())
  siteCategoryId String
  siteCategory   SiteCategory @relation(fields: [siteCategoryId], references: [id], onDelete: Cascade)
  label          String
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model SiteSupervisor {
  siteId String
  userId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([siteId, userId])
}

model Intervention {
  id                      String                      @id @default(cuid())
  siteId                  String
  site                    Site                        @relation(fields: [siteId], references: [id])
  date                    DateTime
  startTime               String
  endTime                 String
  type                    InterventionType
  subType                 String?
  categoryId              String?
  category                InterventionCategory?       @relation(fields: [categoryId], references: [id])
  label                   String?
  photos                  String[]                    @default([])
  status                  InterventionStatus          @default(PLANNED)
  observation             String?
  clientSignature         String?
  billable                Boolean                     @default(true)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  assignments             InterventionAssignment[]
  trucks                  InterventionTruck[]
  anomalies               Anomaly[]
  generatedFromTemplateId String?
  generatedFromTemplate   InterventionTemplate?       @relation(fields: [generatedFromTemplateId], references: [id])
  generatedFromStopId     String?
  batchId                 String?
  attendances             Attendance[]
  checklistItems          InterventionChecklistItem[]
  shiftSwapRequests       ShiftSwapRequest[]
  quotes                  Quote[]

  @@index([batchId])
}

model InterventionChecklistItem {
  id             String       @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  label          String
  order          Int          @default(0)
  done           Boolean      @default(false)
  completedAt    DateTime?
  completedBy    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model InterventionAssignment {
  interventionId String
  userId         String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([interventionId, userId])
}

model InterventionTruck {
  id             String       @id @default(cuid())
  label          String
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
}

model InterventionTemplate {
  id            String         @id @default(cuid())
  label         String
  siteId        String         @unique
  site          Site           @relation(fields: [siteId], references: [id])
  startDate     DateTime       @default(now())
  endDate       DateTime?
  active        Boolean        @default(true)
  validatedAt   DateTime?
  validatedById String?
  validatedBy   User?          @relation("TemplateValidator", fields: [validatedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  stops         TemplateStop[]
  interventions Intervention[]
  /// Modification proposée par un superviseur, en attente de validation : la version actuelle reste active.
  pendingVersion       Json?
  pendingRequestedById String?
  pendingRequestedAt   DateTime?
  revisions            TemplateRevision[]
  exceptions           TemplateException[]
}

/// Photo d'une version appliquée d'un gabarit (historique, retour en arrière).
model TemplateRevision {
  id           String               @id @default(cuid())
  templateId   String
  template     InterventionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  snapshot     Json
  authorId     String?
  approvedById String?
  note         String?
  createdAt    DateTime             @default(now())

  @@index([templateId, createdAt])
}

enum TemplateExceptionKind {
  CANCEL
  REPLACE_AGENTS
}

/// Exception datée d'un créneau de gabarit : un seul jour change, le gabarit reste la référence.
model TemplateException {
  id          String                @id @default(cuid())
  templateId  String
  template    InterventionTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stopId      String
  date        DateTime
  kind        TemplateExceptionKind
  agentIds    String[]              @default([])
  reason      String?
  createdById String?
  createdAt   DateTime              @default(now())

  @@unique([stopId, date])
  @@index([templateId, date])
}

model TemplateStop {
  id            String                @id @default(cuid())
  templateId    String
  template      InterventionTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  daysOfWeek    Int[]
  intervalWeeks Int                   @default(1)
  specificDate  DateTime?
  categoryId    String?
  category      InterventionCategory? @relation(fields: [categoryId], references: [id])
  startTime     String
  endTime       String
  agentIds      String[]
  order         Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([templateId])
}

model Attendance {
  id                String           @id @default(cuid())
  userId            String
  interventionId    String
  date              DateTime
  arrivalTime       DateTime?
  arrivalLatitude   Float?
  arrivalLongitude  Float?
  lastSeenAt        DateTime?
  lastSeenLatitude  Float?
  lastSeenLongitude Float?
  outsideSince      DateTime?
  checkInTime       DateTime?
  checkOutTime      DateTime?
  checkInLatitude   Float?
  checkInLongitude  Float?
  checkInPhoto      String?
  checkOutLatitude  Float?
  checkOutLongitude Float?
  checkOutPhoto     String?
  plannedStart      DateTime?
  plannedEnd        DateTime?
  status            AttendanceStatus @default(PENDING)
  manual            Boolean          @default(false)
  createdBy         String
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id])
  intervention      Intervention     @relation(fields: [interventionId], references: [id], onDelete: Cascade)
}

model Absence {
  id                     String        @id @default(cuid())
  userId                 String
  siteId                 String?
  type                   AbsenceType
  status                 AbsenceStatus @default(PENDING)
  from                   DateTime
  to                     DateTime
  reason                 String
  note                   String?
  attachment             String?
  validatedBy            String?
  validationComment      String?
  manual                 Boolean       @default(false)
  createdBy              String
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  user                   User          @relation(fields: [userId], references: [id])
  site                   Site?         @relation(fields: [siteId], references: [id])
  requiresSecondApproval Boolean       @default(false)
  level1ApprovedBy       String?
  level1ApprovedAt       DateTime?
}

model LeaveAllocation {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year          Int
  allocatedDays Int      @default(25)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, year])
}

model BlockedPeriod {
  id        String   @id @default(cuid())
  from      DateTime
  to        DateTime
  reason    String
  createdAt DateTime @default(now())
}

model Notification {
  id                   String               @id @default(cuid())
  title                String
  message              String
  audience             NotificationAudience
  targetId             String?
  targetName           String?
  category             String?
  priority             NotificationPriority @default(NORMAL)
  /// Payload transmis au client mobile pour la navigation au tap (ex: { interventionId } ou { path }).
  data                 Json?
  scheduledFor         DateTime?
  sentAt               DateTime?
  escalateAfterMinutes Int?
  escalatedAt          DateTime?
  createdAt            DateTime             @default(now())
  reads                NotificationRead[]
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model NotificationTemplate {
  id        String               @id @default(cuid())
  name      String
  title     String
  message   String
  category  String?
  priority  NotificationPriority @default(NORMAL)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model ChatMessage {
  id           String    @id @default(cuid())
  threadUserId String
  threadUser   User      @relation("ChatThread", fields: [threadUserId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User      @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  body         String
  createdAt    DateTime  @default(now())
  readAt       DateTime?
}

model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
}

model Anomaly {
  id             String        @id @default(cuid())
  interventionId String
  intervention   Intervention  @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  type           String
  title          String?
  description    String
  photos         String[]
  status         AnomalyStatus @default(NEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String
  action     AuditAction
  entityType String
  entityId   String?
  details    String?
  before     Json?
  after      Json?
  createdAt  DateTime    @default(now())
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum DocumentType {
  QUOTE
  INVOICE
}

model ApiKey {
  id         String    @id @default(cuid())
  label      String
  key        String    @unique
  scopes     String[]  @default([])
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model ClientPortalToken {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  token     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Quote {
  id             String          @id @default(cuid())
  number         String          @unique
  siteId         String
  site           Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  interventionId String?
  intervention   Intervention?   @relation(fields: [interventionId], references: [id])
  label          String
  clientName     String
  clientAddress  String?
  clientEmail    String?
  notes          String?
  status         QuoteStatus     @default(DRAFT)
  issuedAt       DateTime        @default(now())
  dueAt          DateTime?
  documentUrl    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lineItems      QuoteLineItem[]
  invoices       Invoice[]
}

model QuoteLineItem {
  id             String @id @default(cuid())
  quoteId        String
  quote          Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description    String
  quantity       Float
  unitPriceHT    Float
  vatRatePercent Float  @default(20)
  order          Int    @default(0)
}

model Invoice {
  id            String            @id @default(cuid())
  number        String            @unique
  siteId        String
  site          Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  quoteId       String?
  quote         Quote?            @relation(fields: [quoteId], references: [id])
  label         String
  clientName    String
  clientAddress String?
  clientEmail   String?
  notes         String?
  status        InvoiceStatus     @default(DRAFT)
  issuedAt      DateTime          @default(now())
  dueAt         DateTime?
  paidAt        DateTime?
  paymentMethod String?
  amountPaidHT  Float             @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lineItems     InvoiceLineItem[]
}

model InvoiceLineItem {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Float
  unitPriceHT    Float
  vatRatePercent Float   @default(20)
  order          Int     @default(0)
}

model DocumentSequence {
  id         String       @id @default(cuid())
  type       DocumentType
  year       Int
  lastNumber Int          @default(0)

  @@unique([type, year])
}

model CustomForm {
  id          String                 @id @default(cuid())
  name        String
  fields      Json
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  submissions CustomFormSubmission[]
}

model CustomFormSubmission {
  id             String     @id @default(cuid())
  formId         String
  form           CustomForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  interventionId String?
  siteId         String?
  submittedBy    String
  data           Json
  createdAt      DateTime   @default(now())
}

model UserDashboardLayout {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  layout    Json
  updatedAt DateTime @updatedAt
}
